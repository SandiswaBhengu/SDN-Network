global
    log stdout format raw local0

defaults
    log global
    mode http
    timeout connect 5000ms
    timeout client 50000ms
    timeout server 50000ms

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server backend1 10.10.11.83:80 check
    server backend2 10.10.11.84:80 check

listen stats
    bind *:8080
    stats enable
    stats uri /stats
    stats refresh 5s
    stats show-node
    stats auth admin:admin123
