global:
  scrape_interval: 15s

scrape_configs:
- job_name: node
  static_configs:
  - targets: ['192.168.152.128:9100','192.168.122.182:9100']

alerting:
  alertmanagers:
    - static_configs:
        - targets:
          - "192.168.152.128:9093"  # Your Alertmanager IP


rule_files:
  - "/etc/prometheus/rules.yml"
  - "/etc/prometheus/alerts.yml"
